# PostgreSQL 접속 주소. 비우면 로컬 개발용 sqlite(./dev.db)를 쓴다
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anon
JWT_SECRET=change-me
# 비우면 메일 대신 인증 코드를 서버 로그에 찍는다 (A-1)
SMTP_USER=
SMTP_PASSWORD=
# 비우면 Jev를 호출하지 않고 항상 통과 (B-4)
JUDGE_API_KEY=
# 쉼표로 구분
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TZ=Asia/Seoul
SEMESTER_START=2026-09-01
# dev일 때만 X-Debug-User 헤더가 동작한다. 배포는 반드시 prod
ENV=dev
DEMO_ALWAYS_LIVE=true
# 선택
# JUDGE_THRESHOLD=0.6
# JUDGE_MODEL=
